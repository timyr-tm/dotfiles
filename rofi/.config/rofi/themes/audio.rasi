configuration {
    modes: ["audio_sinks", "audio_sources"];

    kb-move-char-back: "";
    kb-move-char-forward: "";
    kb-mode-previous: "";
    kb-mode-next: "";

    kb-custom-1: "Left";
    kb-custom-2: "Shift+Left";
    kb-custom-3: "Right";
    kb-custom-4: "Shift+Right";

    kb-custom-5: "Shift+space";
}

* {
    font: "FiraCode 18px";
    background-color: #00000000;
    text-color: #cdd6f4;
    line-height: 1;
}

window {
    children: [mode-switcher, listview];
    background-color: #1e1e2e;
    border-radius: 10px;
    width: 790px;
}

mode-switcher {
    border-radius: 10px;
}

button {
    padding: 5px 0 5px 0;
}

button selected {
    background-color: #313244;
}

listview {
    children: [element];
    lines: 5;
}

element {
    children: [element-text];
    border-radius: 10px;
    padding: 5px 10px 5px 10px;
}

element selected {
    background-color: #313244;
}

element-text selected {
    text-color: #89b4fa;
}